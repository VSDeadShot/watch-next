# Every value here is read on the server only. None is prefixed NEXT_PUBLIC_,
# and none may ever be: that prefix means "compile this into the bundle the
# browser downloads", which is the opposite of what a secret needs.
#
# app/api/[...path]/route.ts forwards every /api/* call to the backend with the
# key attached, so the browser talks only to this app's own origin and never
# learns any of these.

# Where the FastAPI backend is listening. The default is this same value, so
# local development needs no .env.local at all. Set it to the Render URL in a
# deployment -- it is read at request time, so changing it needs no rebuild.
API_BASE_URL=http://localhost:8000

# Must match API_SECRET on the backend. Leave unset locally: the backend treats
# an unset secret as "no gate", which is how this runs on a laptop.
WATCH_NEXT_API_SECRET=

# The Basic-auth credential proxy.ts asks a browser for, gating the whole site
# rather than just the API. Required in any deployment: a production build with
# these unset answers 503 to everything rather than serving openly. `next dev`
# ignores them entirely, so a fresh checkout needs neither.
#
# This exists because Vercel's Standard Protection does not cover the production
# domain -- read the comment at the top of proxy.ts before deciding it is
# redundant. There is no lockout behind it, so make the password long and
# random: it is the only thing between the internet and a viewing history.
WATCH_NEXT_USER=
WATCH_NEXT_PASSWORD=

# Waives the check above and lets an unconfigured production build serve
# anyway. The same word the backend uses for the same decision. Never set it in
# a deployment: it means "anyone who can reach this can read everything in it".
ALLOW_UNAUTHENTICATED=false
