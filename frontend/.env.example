# Where the FastAPI backend is listening. Baked into the client bundle at build
# time, hence NEXT_PUBLIC_ -- this app talks to the API from the browser, so
# nothing secret may ever be put in this file.
#
# The default in lib/api.ts is this same value, so local development needs no
# .env.local at all. Set this for a deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
