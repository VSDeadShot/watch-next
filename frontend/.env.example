# Both of these are read on the server only. Neither is prefixed NEXT_PUBLIC_,
# and neither may ever be: that prefix means "compile this into the bundle the
# browser downloads", which is the opposite of what a secret needs.
#
# app/api/[...path]/route.ts forwards every /api/* call to the backend with the
# key attached, so the browser talks only to this app's own origin and never
# learns either value.

# Where the FastAPI backend is listening. The default is this same value, so
# local development needs no .env.local at all. Set it to the Render URL in a
# deployment -- it is read at request time, so changing it needs no rebuild.
API_BASE_URL=http://localhost:8000

# Must match API_SECRET on the backend. Leave unset locally: the backend treats
# an unset secret as "no gate", which is how this runs on a laptop.
WATCH_NEXT_API_SECRET=
