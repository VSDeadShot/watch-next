# Copy to .env and adjust. .env is gitignored.

# SQLite locally; swap for a postgresql+psycopg:// URL in production.
DATABASE_URL=sqlite:///./watch_next.db

# Defaults for JustWatch availability lookups. Country is a two-letter code
# (JustWatch supports 100+); language is a two-letter code.
JW_COUNTRY=IN
JW_LANGUAGE=en

# Netflix rows shorter than this are treated as accidental starts, not views.
MIN_WATCH_SECONDS=60

# Allowed CORS origin for the Next.js dev server.
FRONTEND_ORIGIN=http://localhost:3000
