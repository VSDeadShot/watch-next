# Copy to .env and adjust. .env is gitignored.

# SQLite locally; swap for a postgresql+psycopg:// URL in production.
DATABASE_URL=sqlite:///./watch_next.db

# Defaults for JustWatch availability lookups. Country is a two-letter code
# (JustWatch supports 100+); language is a two-letter code.
JW_COUNTRY=IN
JW_LANGUAGE=en

# Netflix rows shorter than this are treated as accidental starts, not views.
MIN_WATCH_SECONDS=60

# Allowed CORS origin for the Next.js dev server. Note that this is a browser
# policy and not access control -- see API_SECRET below, and app/api/security.py.
FRONTEND_ORIGIN=http://localhost:3000

# The shared secret the Next.js proxy presents as X-API-Key. Empty means the
# API answers anyone, which is fine on localhost and is why it is the default.
# Set it in any deployment: this app has one user and no login, so without it
# whoever has the URL can read the history, rewrite the subscriptions and spend
# the JustWatch budget. /health stays reachable either way, for the platform's
# health check.
#
# Leaving this empty is only allowed where it is plausible. If DATABASE_URL is
# not SQLite, the app treats itself as deployed and REFUSES TO START without a
# secret rather than coming up silently open -- see app/api/security.py. Setting
# it to spaces counts as empty.
API_SECRET=

# The escape hatch for that check, and the only thing that turns the refusal
# above into a warning. Its one honest use is a Postgres running on the same
# machine as you. Never set it in a deployment: it means "this API answers
# anyone who can reach it", and it means exactly that.
ALLOW_UNAUTHENTICATED=false
