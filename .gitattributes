# Normalize line endings: LF in the repository, native in the working copy.
# Without this, developing on Windows produces CRLF/LF churn in every diff.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.db binary
*.sqlite3 binary
